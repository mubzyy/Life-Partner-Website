# PostgreSQL Database Configuration
DATABASE_URL=postgresql://user:password@host:port/dbname

# Server Configuration
PORT=

# JWT Secret (generate a strong random string)
JWT_SECRET=

# SMTP Email Configuration (Nodemailer)
# All five are required — the app fails gracefully (returns a clear error on
# the first send attempt) if any are missing, instead of crashing at boot.
# For Gmail: use a Gmail address + an App Password (NOT your real password),
# generated at https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional — points uploaded profile photos at a mounted persistent disk
# instead of the app's own local uploads/ folder. Leave unset for local dev;
# set this on hosts with an ephemeral filesystem (e.g. Render) once a
# persistent disk is attached, so uploads survive redeploys/restarts.
UPLOADS_DIR=
