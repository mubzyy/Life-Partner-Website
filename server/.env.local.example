# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT server environment
# Copy this file to .env.local and fill in your local values.
# This file is gitignored — never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Local PostgreSQL connection (replace <password> and <dbname> with your values)
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/<dbname>

# Keep the same port the frontend dev config expects
PORT=5000

# Use a strong secret — can reuse the same one as production or use a different one for dev
JWT_SECRET=<your_jwt_secret>

# SMTP email — OTP verification and password-reset emails go through this
# even locally. All five are required. For Gmail: use a Gmail address + an
# App Password (NOT your real password), generated at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your_gmail_address>
SMTP_PASS=<your_gmail_app_password>
SMTP_FROM=Life Partner <your_gmail_address>

# Optional — leave unset locally. See .env.example for what this does.
UPLOADS_DIR=

# IMPORTANT: Set to "development" so db.js disables SSL for local Postgres
NODE_ENV=development
